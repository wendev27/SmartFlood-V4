# SmartFlood V3.2 frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Browser-safe Supabase values only. Do not place service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NODE_ENV=development

# Weather credentials for server-side use only. Never prefix with NEXT_PUBLIC_.
TOMORROW_API_KEY=
OPENWEATHER_API_KEY=
